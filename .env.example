# Copia este fichero como .env y ajusta los valores. El .env no se sube al repositorio.

# --- General ---
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_SECRET=otra-cadena-larga-y-aleatoria-de-al-menos-32-caracteres
JWT_ACCESS_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- Base de datos (MySQL 8 / MariaDB 10.5+) ---
DATABASE_URL=mysql://evolve:evolve@localhost:3306/evolve

# --- Archivos ---
STORAGE_DIR=./storage
STORAGE_BUCKET=evolve
FILE_URL_TTL_SECONDS=3600
MAX_UPLOAD_MB=5

# --- IA ---
# demo: no llama a ninguna API (etiqueta las fotos del cliente). gemini: usa la API de Google AI Studio.
AI_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
AI_WORKER_POLL_SECONDS=5

# --- Taller ---
WORKSHOP_OPENS_AT=09:00
WORKSHOP_CLOSES_AT=18:00
WORKSHOP_WORKING_DAYS=0,1,2,3,4
ENTRY_SLOT_MINUTES=30
VAT_PERCENT=21
QUOTE_VALID_DAYS=14

# --- Correo (si MAIL_SERVER está vacío, los correos se escriben en el log) ---
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_FROM=no-reply@evolve.test
FRONTEND_RESET_URL=evolve://reset-password?token=

# Solo desarrollo: /auth/forgot-password devuelve el token en la respuesta (lo usa Postman). Nunca en producción.
EXPOSE_RESET_TOKEN=true
